<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VietVideo Pro — Tạo Video AI Miễn Phí</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
    <script src="https://unpkg.com/@ffmpeg/ffmpeg@0.12.7/dist/ffmpeg.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#2563eb',
                        secondary: '#7c3aed',
                        accent: '#f59e0b'
                    }
                }
            }
        }
    </script>
    <style>
        [v-cloak] { display: none; }
        .gradient-bg { background: linear-gradient(90deg, #2563eb, #7c3aed); }
        .card-hover:hover { transform: translateY(-4px); box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
        .fade { transition: all 0.3s ease; }
    </style>
</head>
<body class="bg-gray-50 min-h-screen" v-cloak>
    <div id="app" class="container mx-auto px-4 py-8 max-w-6xl">
        <!-- TRANG CHỦ -->
        <div v-if="trang === 'home'" class="fade">
            <div class="text-center mb-12">
                <h1 class="text-4xl font-bold text-blue-600 mb-4">🎬 VietVideo Pro</h1>
                <p class="text-xl text-gray-600">Tạo video từ ảnh & nhạc — miễn phí, chạy ngay trên trình duyệt</p>
            </div>

            <div class="grid md:grid-cols-2 gap-6 mb-10">
                <!-- Thẻ Tạo từ ảnh & nhạc -->
                <div class="bg-white p-6 rounded-2xl shadow card-hover transition-all">
                    <h3 class="text-xl font-semibold mb-3 flex items-center gap-2">
                        <i class="fa-solid fa-images text-blue-500"></i> Tạo từ ảnh & nhạc
                    </h3>
                    <p class="text-gray-600 mb-5">Tải lên hình ảnh, chọn nhạc nền → tạo & xuất file MP4 ngay.</p>
                    <button @click="trang = 'tao-video'" 
                        class="bg-blue-600 text-white px-6 py-2.5 rounded-lg hover:bg-blue-700 transition">
                        Bắt đầu tạo →
                    </button>
                </div>

                <!-- Thẻ AI Gợi ý nội dung -->
                <div class="bg-white p-6 rounded-2xl shadow card-hover transition-all">
                    <h3 class="text-xl font-semibold mb-3 flex items-center gap-2">
                        <i class="fa-solid fa-robot text-green-500"></i> AI Gợi ý nội dung
                    </h3>
                    <p class="text-gray-600 mb-5">Nhập chủ đề → AI gợi ý kịch bản & nội dung video.</p>
                    <button @click="trang = 'ai'" 
                        class="bg-green-600 text-white px-6 py-2.5 rounded-lg hover:bg-green-700 transition">
                        Nhập nội dung →
                    </button>
                </div>

                <!-- Thẻ Mẫu thiết kế sẵn -->
                <div class="bg-white p-6 rounded-2xl shadow card-hover transition-all">
                    <h3 class="text-xl font-semibold mb-3 flex items-center gap-2">
                        <i class="fa-solid fa-palette text-pink-500"></i> Mẫu thiết kế sẵn
                    </h3>
                    <p class="text-gray-600 mb-5">Nhiều mẫu đẹp: giới thiệu, quảng cáo, MXH, du lịch...</p>
                    <button @click="trang = 'mau'" 
                        class="bg-pink-600 text-white px-6 py-2.5 rounded-lg hover:bg-pink-700 transition">
                        Xem mẫu →
                    </button>
                </div>

                <!-- Thẻ Quản lý dự án -->
                <div class="bg-white p-6 rounded-2xl shadow card-hover transition-all">
                    <h3 class="text-xl font-semibold mb-3 flex items-center gap-2">
                        <i class="fa-solid fa-folder-open text-amber-500"></i> Quản lý dự án
                    </h3>
                    <p class="text-gray-600 mb-5">Xem lại, chỉnh sửa, tải lại các video đã tạo.</p>
                    <button @click="trang = 'du-an'" 
                        class="bg-amber-500 text-white px-6 py-2.5 rounded-lg hover:bg-amber-600 transition">
                        Xem dự án →
                    </button>
                </div>
            </div>

            <p class="text-center text-gray-500 text-sm">💡 Hoàn toàn bằng tiếng Việt — Không cần cài đặt gì</p>
        </div>

        <!-- TRANG TẠO VIDEO CHÍNH -->
        <div v-if="trang === 'tao-video'" class="fade">
            <button @click="trang = 'home'" class="mb-6 text-blue-600 hover:underline flex items-center gap-2">
                <i class="fa-solid fa-arrow-left"></i> Quay lại trang chủ
            </button>

            <h2 class="text-2xl font-bold mb-6">🎬 Tạo Video Từ Ảnh & Nhạc</h2>

            <div class="grid md:grid-cols-2 gap-8">
                <!-- BÊN TRÁI: Tải lên & Cài đặt -->
                <div class="space-y-6">
                    <div class="bg-white p-5 rounded-xl shadow">
                        <h3 class="font-semibold mb-3"><i class="fa-solid fa-images text-blue-500 mr-2"></i>Chọn Ảnh</h3>
                        <input type="file" multiple accept="image/*" @change="onChonAnh" 
                            class="w-full p-3 border-2 border-dashed rounded-lg">
                        <div class="mt-3 flex flex-wrap gap-2">
                            <span v-for="(anh, i) in danhSachAnh" :key="i" 
                                class="bg-gray-100 px-3 py-1 rounded text-sm flex items-center gap-2">
                                {{anh.name}}
                                <button @click="danhSachAnh.splice(i,1)" class="text-red-500 font-bold">×</button>
                            </span>
                        </div>
                    </div>

                    <div class="bg-white p-5 rounded-xl shadow">
                        <h3 class="font-semibold mb-3"><i class="fa-solid fa-music text-amber-500 mr-2"></i>Nhạc Nền</h3>
                        <input type="file" accept="audio/*" @change="onChonNhac" 
                            class="w-full p-3 border-2 border-dashed rounded-lg">
                        <p v-if="nhacNen" class="mt-2 text-green-600">✅ {{nhacNen.name}}</p>
                    </div>

                    <div class="bg-white p-5 rounded-xl shadow space-y-4">
                        <h3 class="font-semibold">Cài Đặt</h3>
                        <div>
                            <label class="block text-sm font-medium mb-1">Thời gian hiển thị mỗi ảnh (giây)</label>
                            <input type="number" v-model.number="thoiGianAnh" min="1" max="10" 
                                class="w-full p-2 border rounded-lg">
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1">Chất lượng video</label>
                            <select v-model="chatLuong" class="w-full p-2 border rounded-lg">
                                <option value="640:360">360p — Nhanh tạo</option>
                                <option value="1280:720" selected>720p — HD</option>
                                <option value="1920:1080">1080p — Full HD</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- BÊN PHẢI: Xem trước & Nút tạo -->
                <div class="space-y-6">
                    <div class="bg-white p-5 rounded-xl shadow">
                        <h3 class="font-semibold mb-3">Xem Trước</h3>
                        <div class="aspect-video bg-gray-900 rounded-lg flex items-center justify-center min-h-[240px]">
                            <video v-if="linkVideo" :src="linkVideo" controls 
                                class="w-full h-full object-contain rounded-lg"></video>
                            <p v-else class="text-gray-400 text-center p-4">
                                <i class="fa-solid fa-play-circle text-4xl mb-2 block"></i>
                                Chọn ảnh → nhấn "Tạo Video Ngay"
                            </p>
                        </div>
                    </div>

                    <button @click="xuLyTaoVideo" :disabled="dangXuLy || !danhSachAnh.length"
                        class="w-full gradient-bg text-white py-4 rounded-xl text-lg font-semibold hover:opacity-90 transition disabled:opacity-50">
                        <span v-if="!dangXuLy">✨ TẠO VIDEO NGAY</span>
                        <span v-else>
                            <i class="fa-solid fa-spinner fa-spin mr-2"></i> {{thongBao}} {{tienDo}}%
                        </span>
                    </button>

                    <div v-if="dangXuLy" class="bg-white p-4 rounded-xl shadow">
                        <div class="w-full bg-gray-200 rounded-full h-3">
                            <div class="bg-blue-600 h-3 rounded-full transition-all" 
                                :style="{width: tienDo + '%'}"></div>
                        </div>
                    </div>

                    <div v-if="linkVideo" class="bg-green-50 border border-green-200 p-5 rounded-xl">
                        <h3 class="font-bold text-green-700 mb-3">✅ Tạo Video Thành Công!</h3>
                        <a :href="linkVideo" :download="'vietvideo-' + Date.now() + '.mp4'"
                            class="block w-full text-center bg-green-600 text-white py-3 rounded-lg hover:bg-green-700">
                            <i class="fa-solid fa-download mr-2"></i> TẢI FILE MP4 VỀ MÁY
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- TRANG AI -->
        <div v-if="trang === 'ai'" class="fade">
            <button @click="trang = 'home'" class="mb-6 text-blue-600 hover:underline flex items-center gap-2">
                <i class="fa-solid fa-arrow-left"></i> Quay lại trang chủ
            </button>
            <h2 class="text-2xl font-bold mb-6">🤖 AI Gợi Ý Nội Dung</h2>
            <div class="bg-white p-6 rounded-xl shadow">
                <label class="block font-medium mb-2">Nhập chủ đề hoặc nội dung video:</label>
                <textarea v-model="chuDeAI" rows="4" 
                    class="w-full p-3 border rounded-lg mb-4"
                    placeholder="Ví dụ: Giới thiệu sản phẩm mới, Kỷ niệm ngày thành lập công ty..."></textarea>
                <button @click="taoNoiDungAI" 
                    class="bg-green-600 text-white px-6 py-2.5 rounded-lg hover:bg-green-700">
                    <i class="fa-solid fa-wand-magic-sparkles mr-2"></i> Tạo nội dung gợi ý
                </button>
                <div v-if="ketQuaAI" class="mt-6 p-4 bg-green-50 rounded-lg border border-green-200">
                    <h4 class="font-semibold mb-2">Nội dung gợi ý:</h4>
                    <p class="whitespace-pre-line">{{ketQuaAI}}</p>
                    <button @click="trang='tao-video'" class="mt-3 text-blue-600 hover:underline">
                        → Đi tạo video với nội dung này
                    </button>
                </div>
            </div>
        </div>

        <!-- TRANG MẪU -->
        <div v-if="trang === 'mau'" class="fade">
            <button @click="trang = 'home'" class="mb-6 text-blue-600 hover:underline flex items-center gap-2">
                <i class="fa-solid fa-arrow-left"></i> Quay lại trang chủ
            </button>
            <h2 class="text-2xl font-bold mb-6">🎨 Mẫu Thiết Kế Sẵn</h2>
            <div class="grid md:grid-cols-3 gap-4">
                <div v-for="mau in danhSachMau" :key="mau.id" 
                    @click="chonMau(mau)"
                    class="bg-white p-4 rounded-xl shadow cursor-pointer hover:shadow-lg transition">
                    <div class="text-3xl mb-2">{{mau.icon}}</div>
                    <h3 class="font-semibold">{{mau.ten}}</h3>
                    <p class="text-sm text-gray-500">{{mau.moTa}}</p>
                </div>
            </div>
        </div>

        <!-- TRANG DỰ ÁN -->
        <div v-if="trang === 'du-an'" class="fade">
            <button @click="trang = 'home'" class="mb-6 text-blue-600 hover:underline flex items-center gap-2">
                <i class="fa-solid fa-arrow-left"></i> Quay lại trang chủ
            </button>
            <h2 class="text-2xl font-bold mb-6">📁 Dự Án Đã Tạo</h2>
            <p class="text-gray-500">Danh sách video bạn đã tạo sẽ hiển thị ở đây.</p>
        </div>
    </div>

    <script>
        const { createFFmpeg, fetchFile } = FFmpeg;
        const ffmpeg = createFFmpeg({ log: false });

        Vue.createApp({
            setup() {
                return {
                    trang: 'home',
                    danhSachAnh: [],
                    nhacNen: null,
                    thoiGianAnh: 3,
                    chatLuong: '1280:720',
                    dangXuLy: false,
                    tienDo: 0,
                    thongBao: '',
                    linkVideo: '',
                    chuDeAI: '',
                    ketQuaAI: '',
                    danhSachMau: [
                        { id: 1, ten: 'Giới thiệu', moTa: 'Mở đầu ngắn gọn', icon: '📢' },
                        { id: 2, ten: 'Quảng cáo', moTa: 'Tập trung sản phẩm', icon: '🛍️' },
                        { id: 3, ten: 'Du lịch', moTa: 'Ảnh phong cảnh', icon: '🏞️' },
                        { id: 4, ten: 'Sinh nhật/Kỷ niệm', moTa: 'Ảnh kỷ niệm', icon: '🎂' },
                        { id: 5, ten: 'TikTok/Reels', moTa: 'Định dạng dọc', icon: '📱' },
                        { id: 6, ten: 'Giáo dục', moTa: 'Chia sẻ kiến thức', icon: '📚' }
                    ]
                };
            },
            methods: {
                onChonAnh(e) {
                    this.danhSachAnh = Array.from(e.target.files);
                    this.linkVideo = '';
                },
                onChonNhac(e) {
                    this.nhacNen = e.target.files[0];
                },
                async xuLyTaoVideo() {
                    if (!this.danhSachAnh.length) {
                        alert('Vui lòng chọn ít nhất 1 ảnh!');
                        return;
                    }
                    
                    this.dangXuLy
